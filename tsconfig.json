{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "paths": {
      "@": ["./src"],
      "@config": ["./src/config"],
      "@base": ["./src/common/base"],
      "@decorators": ["./src/common/decorators"],
      "@guards": ["./src/common/guards"],
      "@exceptions": ["./src/common/exceptions"],
      "@utils": ["./src/common/utils"],
      "@interfaces": ["./src/common/interfaces"],

      "@core/*": ["./src/modules/core/*"],
      // "@admin/*": ["./src/modules/admin/*"],
      "@public/*": ["./src/modules/public/*"],

      "@shared": ["./src/shared"],
      "@DTO": ["./src/database/DTO"],
      "@entities": ["./src/database/entities"],
      "@repositories": ["./src/database/repositories"],

      "@AdminEntities": ["./src/database/admin/entities"],
      "@AdminRepositories": ["./src/database/admin/repositories"],
      "@AdminDTOs": ["./src/database/admin/DTO"],
      "@AdminMapper": ["./src/modules/admin/mapper"],
      "@AdminServices": ["./src/modules/admin/services"],
      "@AdminControllers": ["./src/modules/admin/controllers"],

      "@CoreEntities": ["./src/database/core/entities"],
      "@CoreRepositories": ["./src/database/core/repositories"],
      "@CoreDTOs": ["./src/database/core/DTO"],
      "@CoreServices": ["./src/modules/core/services"],
      "@CoreMapper": ["./src/modules/core/mapper"],
      "@CoreControllers": ["./src/modules/core/controllers"],

      "@PublicEntities": ["./src/database/public/entities"],
      "@PublicDTOs": ["./src/database/public/DTO"],
      "@PublicRepositories": ["./src/database/public/repositories"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}
